{
  "name": "english-coach",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite web --port 5173",
    "server": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "build": "vite build web",
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "typecheck": "tsc -p web --noEmit && tsc -p server --noEmit",
    "harness": "node --env-file-if-exists=.env harness/server.mjs"
  },
  "dependencies": {
    "@google/genai": "2.25.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "5.4.2",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.2"
  }
}
